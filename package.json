{
  "name": "pdfpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server\" --names \"VITE,EXPRESS\" --prefix-colors \"cyan.bold,magenta.bold\"",
    "client": "vite",
    "server": "npm run start:dev --prefix ./pdfpulse-backend",
    "build": "vite build && npm run build --prefix ./pdfpulse-backend",
    "preview": "npm run build && npm start",
    "start": "node pdfpulse-backend/dist/main.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.2.0",
    "@nestjs/cli": "^11.0.10",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "docx": "^9.5.1",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase": "^12.5.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "mammoth": "^1.11.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^5.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "vite": "^7.1.12"
  }
}
